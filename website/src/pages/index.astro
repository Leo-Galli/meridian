---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const features = [
  {
    icon: "layout",
    title: "Drag & drop HUD layout",
    desc: "Move every module anywhere on screen with the built-in layout editor. No config files, no restart - just grab and place.",
  },
  {
    icon: "keys",
    title: "Keystrokes overlay",
    desc: "Live WASD, spacebar and mouse buttons with smooth press highlighting, so you can show exactly what you are doing.",
  },
  {
    icon: "pin",
    title: "Waypoint system",
    desc: "Mark bases, builds and coordinates in the world. Render colored markers with live distance, right in the 3D view.",
  },
  {
    icon: "chat",
    title: "AutoText macros",
    desc: "Bind frequently used chat messages and commands to any key and send them instantly without ever opening chat.",
  },
  {
    icon: "pulse",
    title: "Performance metrics",
    desc: "FPS, memory usage and click speed always visible. Keep an eye on your system while you play.",
  },
  {
    icon: "sliders",
    title: "Total control",
    desc: "Per-module toggles, scale, background opacity, custom colors and shadows. Make the HUD truly yours.",
  },
];

const modules = [
  { n: "01", name: "Keystrokes", desc: "WASD, spacebar and mouse click overlay with press highlights" },
  { n: "02", name: "CPS Counter", desc: "Live left and right clicks-per-second with activity bars" },
  { n: "03", name: "Ping Display", desc: "Current server latency in milliseconds" },
  { n: "04", name: "RAM Usage", desc: "Dynamic memory usage with bar and percentage" },
  { n: "05", name: "Server Info", desc: "Server name and address, shown while you play" },
  { n: "06", name: "Waypoints", desc: "Custom in-world markers with colors, icons and distance" },
  { n: "07", name: "AutoText Macros", desc: "Keybound quick-chat messages and commands" },
  { n: "08", name: "FPS Counter", desc: "Frames per second, always on screen" },
  { n: "09", name: "Armor Status", desc: "Equipped armor with live durability bars" },
  { n: "10", name: "Direction Compass", desc: "16-wind compass with a sliding bearing strip" },
];

const steps = [
  { title: "Install Fabric", desc: "Run the Fabric installer for Minecraft 1.21.8 and pick the client option." },
  { title: "Drop in the jars", desc: "Place both <code>fabric-api</code> and <code>meridian.jar</code> in your <code>mods</code> folder." },
  { title: "Press Page Up", desc: "Launch the game and open the Meridian menu with <b>Page Up</b> - or rebind it in Controls." },
  { title: "Make it yours", desc: "Toggle modules, drag them around in the HUD Layout Editor and save waypoints." },
];

const icons = {
  layout: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/></svg>',
  keys: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="6" height="5" rx="1"/><rect x="10" y="6" width="6" height="5" rx="1"/><rect x="18" y="6" width="4" height="5" rx="1"/><rect x="2" y="13" width="20" height="5" rx="1"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.3-7-11a7 7 0 1 1 14 0c0 4.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>',
  chat: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5Z"/></svg>',
  pulse: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-7 4 14 3-7h6"/></svg>',
  sliders: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h10M18 8h2M4 16h2M10 16h10"/><circle cx="16" cy="8" r="2"/><circle cx="8" cy="16" r="2"/></svg>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Meridian - Client HUD Suite for Minecraft 1.21.8</title>
    <meta
      name="description"
      content="Meridian is a modern client-side HUD suite for Minecraft 1.21.8: keystrokes, CPS, ping, RAM, server info, waypoints, macros, armor status and a direction compass - all fully customizable."
    />
    <meta name="theme-color" content="#04070d" />
    <meta property="og:title" content="Meridian - Client HUD Suite for Minecraft" />
    <meta
      property="og:description"
      content="Keystrokes, waypoints, macros and more. A fully customizable HUD for Minecraft 1.21.8 on Fabric."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://meridian-mod.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top">
    <Header />

    <main>
      <section class="hero container">
        <span class="hero-badge"><span class="dot"></span> Now for Minecraft 1.21.8</span>
        <h1>
          Your game.<br />
          <span class="gradient-text">Your HUD.</span> No limits.
        </h1>
        <p class="hero-sub">
          Meridian is a modern client-side HUD suite for Fabric - keystrokes, click speed,
          waypoints, macros and live server metrics, all fully customizable and draggable.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/download">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4" />
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            Download the mod
          </a>
          <a class="btn btn-ghost" href="https://github.com/Leo-Galli/meridian" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.91c.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.27 5.66.41.35.77 1.05.77 2.12v3.14c0 .3.2.67.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
            </svg>
            View on GitHub
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat"><div class="num">10</div><div class="lbl">Modules</div></div>
          <div class="stat"><div class="num">100%</div><div class="lbl">English</div></div>
          <div class="stat"><div class="num">1.21.8</div><div class="lbl">Minecraft</div></div>
          <div class="stat"><div class="num">MIT</div><div class="lbl">Open source</div></div>
        </div>

        <div class="hud-stage">
          <div class="hud-frame">
            <span class="hud-corner tl"></span>
            <span class="hud-corner br"></span>
            <div class="hud-topbar">
              <span>Meridian</span>
              <span>FPS <span class="fps">144</span> &nbsp;&bull;&nbsp; Ping <span class="ping">24ms</span></span>
              <span>Server <span style="color: var(--text-0)">play.example.net</span></span>
            </div>
            <div class="hud-body">
              <div class="keystrokes">
                <span class="key w pressed">W</span>
                <span class="key a pressed">A</span>
                <span class="key s pressed">S</span>
                <span class="key d pressed">D</span>
                <span class="key space pressed">SPACE</span>
              </div>
              <div class="mouse-keys">
                <span class="mouse-key">LMB</span>
                <span class="mouse-key right">RMB</span>
              </div>
              <div class="cps">
                <div class="cps-row">
                  <span class="cps-label">CPS</span>
                  <span class="cps-value">8.4</span>
                </div>
                <div class="cps-bar"><div class="cps-bar-fill"></div></div>
              </div>
              <div class="compass">
                <span class="compass-marker"></span>
                <div class="compass-strip">
                  <span>N</span><span>NE</span><span>E</span><span>SE</span><span>S</span><span>SW</span><span>W</span><span>NW</span><span>N</span><span>NE</span><span>E</span><span>SE</span><span>S</span><span>SW</span><span>W</span><span>NW</span>
                </div>
                <div class="compass-deg">32&deg; NNE</div>
              </div>
              <div class="waypoint-tag">
                <span class="waypoint-pin"></span>
                <span class="name">Home</span>
                <span class="dist">128m</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">Features</span>
            <h2>Everything you need, <span class="gradient-text">nothing you don't</span></h2>
            <p>Meridian bundles the essentials of a competitive HUD into one clean, configurable package.</p>
          </div>
          <div class="feature-grid">
            {
              features.map((f) => (
                <article class="feature-card reveal">
                  <div class="feature-icon" set:html={icons[f.icon as keyof typeof icons]} />
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="modules">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">Modules</span>
            <h2>Ten modules. <span class="gradient-text">All included.</span></h2>
            <p>Every module is toggleable, rescalable, recolored and repositionable on the fly.</p>
          </div>
          <div class="modules-panel reveal">
            {
              modules.map((m) => (
                <div class="module-row">
                  <span class="module-tag">{m.n}</span>
                  <div class="module-info">
                    <h3>{m.name}</h3>
                    <p>{m.desc}</p>
                  </div>
                  <span class="module-pill">Included</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="install">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">Getting started</span>
            <h2>Up and running <span class="gradient-text">in minutes</span></h2>
            <p>No launcher tricks, no mess. Fabric, two jars, one keypress.</p>
          </div>
          <div class="steps">
            {steps.map((s) => <div class="step reveal" set:html={`<h3>${s.title}</h3><p>${s.desc}</p>`} />)}
          </div>
        </div>
      </section>

      <section class="section" id="download">
        <div class="container">
          <div class="download-panel reveal">
            <span class="eyebrow" style="justify-content: center;">Download</span>
            <h2>Ready when you are</h2>
            <p class="lead">
              Grab the latest release jar from GitHub and drop it into your mods folder together
              with Fabric API for 1.21.8.
            </p>
            <div class="badges">
              <span class="badge"><b>Minecraft</b> 1.21.8</span>
              <span class="badge"><b>Fabric API</b> 0.136.1+</span>
              <span class="badge"><b>Loader</b> 0.16.13+</span>
              <span class="badge"><b>Java</b> 21+</span>
            </div>
            <a class="download-cta" href="/download">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4" />
                <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
              </svg>
              Get the release jar
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      for (const el of document.querySelectorAll(".reveal")) {
        observer.observe(el);
      }
    </script>
  </body>
</html>