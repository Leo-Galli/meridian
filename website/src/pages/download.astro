---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const latestJar = "https://github.com/Leo-Galli/meridian/releases/latest/download/meridian.jar";
const releases = "https://github.com/Leo-Galli/meridian/releases";

let latestVersion = "1.3.0";
try {
  const res = await fetch("https://api.github.com/repos/Leo-Galli/meridian/releases/latest", {
    signal: AbortSignal.timeout(6000),
  });
  if (res.ok) {
    const data = await res.json();
    if (data && data.tag_name) {
      latestVersion = String(data.tag_name).replace(/^v/, "");
    }
  }
} catch {}

const steps = [
  { title: "Install Fabric", desc: "Run the Fabric installer for Minecraft 1.21.8 and pick the client option." },
  { title: "Drop in the jars", desc: "Place both <code>fabric-api</code> and <code>meridian.jar</code> in your <code>mods</code> folder." },
  { title: "Press Page Up", desc: "Launch the game and open the Meridian menu with <b>Page Up</b> - or rebind it in Controls." },
  { title: "Make it yours", desc: "Toggle modules, drag them around in the HUD Layout Editor and save waypoints." },
];

const faqs = [
  {
    q: "Does this link always download the latest version?",
    a: "Yes. The button points to the latest GitHub release, so it always downloads the newest jar automatically - no need to update the link.",
  },
  {
    q: "Do I need Fabric API?",
    a: "Yes, Meridian requires Fabric API 0.136.1 or newer for Minecraft 1.21.8. Download it from Modrinth or CurseForge and place it in the same mods folder.",
  },
  {
    q: "Can I move my settings to another computer?",
    a: "Open the Meridian menu (Page Up), go to Backup & Transfer and press Export Settings. Copy the generated meridian-transfer.json file to the new machine and press Import Settings there.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Download Meridian - Client HUD Suite for Minecraft 1.21.8</title>
    <meta
      name="description"
      content="Download the latest Meridian HUD mod for Minecraft 1.21.8. Direct link to the newest release jar on GitHub, with install instructions for Fabric."
    />
    <meta name="theme-color" content="#04070d" />
    <meta property="og:title" content="Download Meridian - Client HUD Suite for Minecraft" />
    <meta property="og:description" content="Grab the latest release jar for Minecraft 1.21.8 and get keystrokes, waypoints, macros and more." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://meridian-mod.vercel.app/download" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top">
    <Header />

    <main>
      <section class="hero container" style="padding-bottom: 60px;">
        <span class="hero-badge"><span class="dot"></span> Latest release always</span>
        <h1>
          Download <span class="gradient-text">Meridian</span>
        </h1>
        <p class="hero-sub">
          One click, newest version. This page always points to the latest release jar on GitHub.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={latestJar}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4" />
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            Download meridian.jar
          </a>
          <a class="btn btn-ghost" href={releases} target="_blank" rel="noopener">
            All releases
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat"><div class="num">{latestVersion}</div><div class="lbl">Current</div></div>
          <div class="stat"><div class="num">1.21.8</div><div class="lbl">Minecraft</div></div>
          <div class="stat"><div class="num">10</div><div class="lbl">Modules</div></div>
          <div class="stat"><div class="num">MIT</div><div class="lbl">License</div></div>
        </div>
      </section>

      <section class="section" id="requirements" style="padding-top: 40px;">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">Requirements</span>
            <h2>What you need</h2>
          </div>
          <div class="badges" style="margin-bottom: 8px;">
            <span class="badge"><b>Minecraft</b> 1.21.8</span>
            <span class="badge"><b>Fabric API</b> 0.136.1+</span>
            <span class="badge"><b>Loader</b> 0.16.13+</span>
            <span class="badge"><b>Java</b> 21+</span>
          </div>
        </div>
      </section>

      <section class="section" id="install" style="padding-top: 20px;">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">Installation</span>
            <h2>Four steps, <span class="gradient-text">that's it</span></h2>
          </div>
          <div class="steps">
            {steps.map((s) => <div class="step reveal" set:html={`<h3>${s.title}</h3><p>${s.desc}</p>`} />)}
          </div>
        </div>
      </section>

      <section class="section" id="faq" style="padding-top: 20px;">
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">FAQ</span>
            <h2>Questions, <span class="gradient-text">answered</span></h2>
          </div>
          <div class="steps" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
            {
              faqs.map((f) => (
                <div class="step reveal">
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      for (const el of document.querySelectorAll(".reveal")) {
        observer.observe(el);
      }
    </script>
  </body>
</html>