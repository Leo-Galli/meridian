---
const links = [
  { href: "#features", label: "Features" },
  { href: "#modules", label: "Modules" },
  { href: "#install", label: "Install" },
  { href: "#download", label: "Download" },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="Meridian home">
      <span class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#03121a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 L20 12 L12 22 L4 12 Z" />
          <path d="M12 7 L16 12 L12 17 L8 12 Z" fill="#03121a" stroke="none" />
        </svg>
      </span>
      <span>Meridian</span>
    </a>
    <nav class="nav">
      <span class="nav-links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
      <a class="nav-cta" href="#download">Get the mod</a>
    </nav>
  </div>
</header>