{
  "schemaVersion": 1,
  "id": "meridian",
  "version": "${version}",
  "name": "Meridian",
  "description": "A modern client-side HUD suite with keystrokes, CPS, ping, RAM, server info, waypoints, macros, armor status, compass and more.",
  "authors": [
    "Leo Galli"
  ],
  "contact": {
    "homepage": "https://meridian-mod.vercel.app/",
    "issues": "https://github.com/Leo-Galli/meridian/issues",
    "sources": "https://github.com/Leo-Galli/meridian"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.meridian.MeridianClient"
    ],
    "modmenu": [
      "dev.meridian.compat.ModMenuCompat"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.13",
    "minecraft": ">=1.21.8 <1.21.9-",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}